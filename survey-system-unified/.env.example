# Unified Survey System Environment Configuration

# Required: PostgreSQL connection
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=survey_db
PG_USER=survey_user
PG_PASSWORD=<generate: openssl rand -base64 32>

# Required: security secrets (use unique, high-entropy values in production)
JWT_SECRET=<generate: openssl rand -base64 32>
CRYPTO_SECRET=<generate: openssl rand -base64 32>
HMAC_SECRET=<generate: openssl rand -base64 32>
SESSION_SECRET=<generate: openssl rand -base64 32>

# Alternative for mounted secrets (use either VAR or VAR_FILE, never both):
# PG_PASSWORD_FILE=/run/secrets/pg_password
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# CRYPTO_SECRET_FILE=/run/secrets/crypto_secret
# HMAC_SECRET_FILE=/run/secrets/hmac_secret
# SESSION_SECRET_FILE=/run/secrets/session_secret

# Required: server port
PORT=5000

# Optional: runtime mode and cross-origin frontend URL
NODE_ENV=production
# FRONTEND_URL=http://localhost:3000

# Optional: AI service endpoints
# BERTSENT_ENDPOINT=http://localhost:8001
# BERTOPIC_ENDPOINT=http://localhost:8002
# BERTRCLS_ENDPOINT=http://localhost:8003

# Optional: database table names for municipalities and localized text
# PG_MUNICIPALITIES=municipalities
# PG_LOCALIZATION=localization
