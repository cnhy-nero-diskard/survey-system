# Unified Survey System Environment Configuration

# Required: PostgreSQL connection
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=survey_db
PG_USER=survey_user
PG_PASSWORD=change_me

# Required: security secrets (use unique, high-entropy values in production)
JWT_SECRET=change_me_in_production
CRYPTO_SECRET=change_me_in_production
HMAC_SECRET=change_me_in_production
SESSION_SECRET=change_me_in_production

# Required: server port
PORT=5000

# Optional: runtime mode and cross-origin frontend URL
NODE_ENV=production
# FRONTEND_URL=http://localhost:3000

# Optional: AI service endpoints
# BERTSENT_ENDPOINT=http://localhost:8001
# BERTOPIC_ENDPOINT=http://localhost:8002
# BERTRCLS_ENDPOINT=http://localhost:8003

# Optional: database table names for municipalities and localized text
# PG_MUNICIPALITIES=municipalities
# PG_LOCALIZATION=localization
