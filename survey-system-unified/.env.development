# Development Environment Configuration

# Required: PostgreSQL connection
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=survey_db_dev
PG_USER=survey_user
PG_PASSWORD=dev_password

# Required: development-only secrets; replace before production deployment
JWT_SECRET=dev_jwt_secret
CRYPTO_SECRET=dev_crypto_secret
HMAC_SECRET=dev_hmac_secret
SESSION_SECRET=dev_session_secret

# Required: server port
PORT=5000

# Optional: local runtime configuration
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Optional: local AI service endpoints
# BERTSENT_ENDPOINT=http://localhost:8001
# BERTOPIC_ENDPOINT=http://localhost:8002
# BERTRCLS_ENDPOINT=http://localhost:8003

# Optional: database table names
PG_MUNICIPALITIES=municipalities
PG_LOCALIZATION=localization
